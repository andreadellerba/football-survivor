rules_version = '2';
// Football Survivor. Ogni telefono ha un'identità anonima; entra in una lega scrivendo
// leagues/{lega}/devices/{suo id} con il codice personale, accettato solo se l'impronta
// coincide con secrets/{utente} (che nessuno può leggere).
// Tutti i giocatori stanno in un solo documento (board/main) per consumare poche letture.
service cloud.firestore {
  match /databases/{database}/documents {
    match /leagues/{c} {
      function signed() { return request.auth != null; }
      function devDoc() { return /databases/$(database)/documents/leagues/$(c)/devices/$(request.auth.uid); }
      function boardDoc() { return /databases/$(database)/documents/leagues/$(c)/board/main; }
      function isMember() { return signed() && exists(devDoc()); }
      function myUser() { return get(devDoc()).data.user; }
      function isAdmin() { return isMember() && get(boardDoc()).data.members[myUser()].get('admin', false) == true; }
      function lg() { return get(/databases/$(database)/documents/leagues/$(c)).data; }
      function isCreator(u) { return signed() && lg().creatorUid == request.auth.uid && lg().admin == u; }
      // chi crea una lega nuova deve essere admin di un'altra lega ("parent") con questo stesso telefono
      function adminOf(p) {
        let dv = /databases/$(database)/documents/leagues/$(p)/devices/$(request.auth.uid);
        return p is string && p.size() == 6 && exists(dv)
          && get(/databases/$(database)/documents/leagues/$(p)/board/main).data.members[get(dv).data.user].get('admin', false) == true;
      }

      allow get: if signed();
      allow list: if false;
      allow create: if signed() && c.matches('^[A-Z0-9]{6}$') && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.admin is string && request.resource.data.startAt is timestamp && request.resource.data.size() < 20
        && adminOf(request.resource.data.parent);
      // la giornata di partenza (uguale per tutti) la cambia solo un admin e solo prima che la lega inizi
      allow update: if isAdmin() && request.resource.data.creatorUid == resource.data.creatorUid && request.resource.data.size() < 20
        && request.resource.data.startAt is timestamp
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['startMd', 'startAt']) || request.time < resource.data.startAt);
      // le leghe restano per sempre (storico): si cancellano solo dalla console di Firebase
      // (tranne le leghe delle prove automatiche, figlie di TQROOT, che le prove stesse ripuliscono)
      allow delete: if isAdmin() && resource.data.get('parent', '') == 'TQROOT';

      match /board/{doc} {
        function newM() { return request.resource.data.members; }
        function oldM() { return resource.data.members; }
        function onlyMembers() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastJoin']); }
        // ognuno cambia solo la propria scelta (con l'orario del server) e il proprio avatar
        function selfOk(d, o) {
          let ch = d.diff(o).affectedKeys();
          return ch.hasOnly(['picks', 'pickAt', 'lastMd', 'avatar']) && (!ch.hasAny(['picks', 'pickAt']) || (
            d.picks.diff(o.get('picks', {})).affectedKeys().hasOnly([d.lastMd]) &&
            d.pickAt.diff(o.get('pickAt', {})).affectedKeys().hasOnly([d.lastMd]) &&
            d.pickAt[d.lastMd] == request.time));
        }
        function selfEdit() {
          let me = myUser();
          return onlyMembers() && newM().diff(oldM()).affectedKeys().hasOnly([me]) && me in newM() && selfOk(newM()[me], oldM()[me]);
        }
        // chi ha ricevuto il codice conferma l'ingresso (gioca dalla giornata di partenza della lega, come tutti)
        function activate() {
          let me = myUser();
          return onlyMembers() && newM().diff(oldM()).affectedKeys().hasOnly([me]) && me in newM()
            && oldM()[me].status == 'invited' && newM()[me].status == 'active'
            && newM()[me].diff(oldM()[me]).affectedKeys().hasOnly(['status']);
        }
        // richiesta di ingresso: solo prima che la lega inizi; un nome utente nuovo, in attesa, senza vite né permessi, firmata col telefono che la manda
        function joinReq() {
          let k = request.resource.data.lastJoin;
          return onlyMembers() && request.time < lg().startAt && k is string && k.matches('^[a-z0-9_]{3,20}$') && !(k in oldM())
            && newM().diff(oldM()).affectedKeys().hasOnly([k]) && newM()[k].status == 'pending'
            && newM()[k].get('admin', false) == false && newM()[k].get('lives', 0) == 0 && newM()[k].uid == request.auth.uid
            && newM()[k].keys().hasOnly(['nome', 'cognome', 'status', 'created', 'lives', 'picks', 'avatar', 'uid']);
        }
        // annullare una richiesta ancora in attesa: solo dal telefono che l'ha mandata
        function cancelReq() {
          let k = request.resource.data.lastJoin;
          return onlyMembers() && k is string && k in oldM() && !(k in newM())
            && newM().diff(oldM()).affectedKeys().hasOnly([k]) && oldM()[k].status in ['pending', 'invited']
            && oldM()[k].get('uid', '') == request.auth.uid;
        }
        allow get: if signed();
        allow list: if false;
        allow create: if doc == 'main' && signed() && lg().creatorUid == request.auth.uid
          && request.resource.data.members.keys().hasOnly([lg().admin]);
        allow update: if doc == 'main' && request.resource.data.members.size() < 400 && (
          isAdmin() || joinReq() || cancelReq() || (isMember() && (selfEdit() || activate())));
        allow delete: if isAdmin() && lg().get('parent', '') == 'TQROOT';
      }

      // impronte dei codici personali: non le legge nessuno, le scrivono solo gli admin
      match /secrets/{u} {
        allow read: if false;
        allow write: if isAdmin() || isCreator(u);
      }

      // telefoni entrati nella lega
      match /devices/{id} {
        allow get: if signed() && request.auth.uid == id;
        allow list: if isAdmin();
        allow delete: if (signed() && request.auth.uid == id) || isAdmin();
        allow create, update: if signed() && request.auth.uid == id
          && request.resource.data.keys().hasOnly(['user', 'key', 'at'])
          && exists(/databases/$(database)/documents/leagues/$(c)/secrets/$(request.resource.data.user))
          && hashing.sha256(request.resource.data.key + request.resource.data.user).toHexString().lower()
             == get(/databases/$(database)/documents/leagues/$(c)/secrets/$(request.resource.data.user)).data.h;
      }

      // chi c'è dietro ogni nickname: lo scrivono, leggono e modificano solo gli admin
      match /notes/{u} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['who', 'at'])
          && request.resource.data.who is string && request.resource.data.who.size() <= 80;
      }

      // registro attività: solo gli admin lo leggono e ci scrivono; non si modifica né si cancella
      match /log/{id} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.keys().hasOnly(['at', 'by', 't'])
          && request.resource.data.by == myUser() && request.resource.data.t.size() < 300;
        allow update, delete: if false;
      }
    }
  }
}
